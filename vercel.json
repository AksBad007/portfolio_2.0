{
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/blog",
            "destination": "https://website-blogs-psi.vercel.app/blog"
        },
        {
            "source": "/blog/:path*",
            "destination": "https://website-blogs-psi.vercel.app/blog/:path*"
        }
    ]
}
